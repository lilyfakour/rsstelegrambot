# --- Telegram RSS Reader Bot configuration ---

# Bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Don't know your ID? Start the bot without it and it will tell you.
# Changes take effect without restarting the bot.
ALLOWED_IDS=

# Default minutes between feed checks (can be changed with /interval)
DEFAULT_INTERVAL_MINUTES=15

# Anti-flood: max posts delivered per feed per check cycle
MAX_POSTS_PER_CHECK=5

# SQLite database file
DB_PATH=bot.db

# --- Telegram RSS Reader Bot configuration (webhook / Vercel edition) ---

# Bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Don't know your ID? Message the bot without it and it will tell you.
ALLOWED_IDS=

# Default minutes between feed checks (can be changed with /interval)
DEFAULT_INTERVAL_MINUTES=15

# Anti-flood: max posts delivered per feed per check cycle
MAX_POSTS_PER_CHECK=5

# --- Turso (libSQL) — replaces the local bot.db SQLite file ---
# Create a free database at https://turso.tech, then:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Security ---
# Any random string. Used to verify incoming webhook calls really come from
# Telegram (sent back as the X-Telegram-Bot-Api-Secret-Token header), and to
# protect /api/setup and /api/cron. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
